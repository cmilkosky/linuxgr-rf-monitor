# rf-scanner lane (watchlist wideband scanner) - copy to
# /home/cmilkosk/.config/rf-scanner.env and fill in the ASR key.
#
# RF_SCANNER_DEVICE is a libusb INDEX (rtl_sdr has no serial flag).
#   2 = SN RTL2 on the D3000N feed (the dongle the hopper held)
#   1 = SN RTL0 (ADS-B, owned by readsb - never use)
#   0 = SN RTL3 (LAN share, sdr-rtl-tcp - never use)
# Re-read `rtl_test -t` after any USB change.
RF_SCANNER_DEVICE=2

# 2.4 MS/s covers ~1.9 MHz usable. Every watchlist entry is grouped into a chunk
# that fits; each chunk is captured once and every channel in it is measured in
# the same FFT pass - that is the "scanner" part (no per-channel retune).
RF_SCANNER_RATE=2400000
RF_SCANNER_DWELL_S=5
# Squelch: channel power must be this far above the chunk's median floor before it
# is demodulated. Empty channels measure 0-3 dB, so 8 is a clean gate.
RF_SCANNER_SQUELCH_DB=8
# Re-recording guard per frequency.
RF_SCANNER_COOLDOWN_S=90
RF_SCANNER_MAX_PER_CHUNK=3
# Record anything above squelch, even with no voice and no data decode - the point
# is that nothing is silently dropped ("voice, data, or otherwise").
RF_SCANNER_KEEP_SILENT=1
# Gain: "auto" lets rtl_sdr use the tuner default; a fixed dB value (e.g. 28) is
# steadier on a strong local plant. Lower it if the whole band reads high.
RF_SCANNER_GAIN=auto

# ASR: whisper large-v3 behind the Frigate audio gateway on linux5. The gateway is
# auth'd - the key is AUDIO_ADAPTER_API_KEY in /etc/frigate-audio-asr-gateway.env
# on 192.168.202.59. Never commit a key; this file stays 0640 root:cmilkosk.
RF_SCANNER_ASR_ENABLE=1
RF_SCANNER_ASR_URL=http://192.168.202.59:10401/v1/audio/transcriptions
RF_SCANNER_ASR_TIMEOUT=120
# RF_SCANNER_ASR_KEY=<from /etc/frigate-audio-asr-gateway.env on linux5>
