[Unit]
Description=RF Monitor ADS-B demodulator (dump1090, 1090 MHz, dedicated RTL)
Documentation=https://github.com/cmilkosky/linuxgr-rf-monitor
After=network.target

[Service]
Type=simple
User=cmilkosk
Group=cmilkosk
# Runs as cmilkosk, not the packaged 'dump1090' user: the RTL device nodes are
# root:plugdev and cmilkosk is in plugdev, so this needs no udev change.
ExecStart=/usr/bin/dump1090-mutability --device-index 0 --write-json /home/cmilkosk/rf-monitor/signals/adsb --quiet
Restart=always
RestartSec=5
# Give the RTL a moment to enumerate after a reboot before the first open fails.
StartLimitIntervalSec=0
Nice=-5

[Install]
WantedBy=multi-user.target
