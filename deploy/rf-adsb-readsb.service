[Unit]
Description=RF Monitor ADS-B demodulator (readsb, 1090 MHz, dedicated RTL)
Documentation=https://github.com/cmilkosky/linuxgr-rf-monitor
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=cmilkosk
Group=cmilkosk
# Runs as cmilkosk, not a packaged user: the RTL device nodes are root:plugdev and
# cmilkosk is in plugdev, and it must own the JSON files tar1090 serves.
#
# Replaced dump1090-mutability on 2026-10-28. Same device, same gain, same JSON
# directory - the only functional difference is --db-file, which is what makes
# readsb emit registration (r), type (t) and dbFlags so tar1090 can show details
# instead of just hex and callsign.
#
# --gain 49.6 is deliberately the same max gain the ADS-B baseline was measured at
# (dump1090's default). readsb's own default is "auto"; do not silently change it.
# No --net-* flags on purpose: nothing consumes the TCP feeds, tar1090 reads files.
# --device RTL0 is the USB serial of the dongle on the dedicated FlightAware
# 1090/978 antenna (hub port 7-1.1.3), NOT an index. libusb indices re-order
# whenever a dongle is added or re-plugged (2026-11-02: 0=RTL3, 1=RTL0, 2=RTL2),
# and an index pin silently followed the shuffle. readsb accepts index or serial.
# Station position, for tar1090 range rings and for computing max/p90/median range
# the same way docs/ADSB-BASELINE.md does. The latitude/longitude are NOT in this
# file: this repo is public and that would publish a home address. They live only on
# the host in /home/cmilkosk/.config/rf-adsb-station.env (mode 600) and reach readsb
# through this EnvironmentFile. Reinstalling the unit onto a fresh host requires
# recreating that file (RF_ADSB_LAT=<lat>, RF_ADSB_LON=<lon>), otherwise the unit
# fails to start on the missing file rather than running without a position.
EnvironmentFile=/home/cmilkosk/.config/rf-adsb-station.env
ExecStart=/usr/local/bin/readsb \
    --device-type rtlsdr --device RTL0 \
    --gain 49.6 \
    --lat ${RF_ADSB_LAT} --lon ${RF_ADSB_LON} \
    --write-json /home/cmilkosk/rf-monitor/signals/adsb --write-json-every 1 \
    --db-file /usr/local/share/tar1090/aircraft.csv.gz \
    --quiet
Restart=always
RestartSec=5
Nice=-5

[Install]
WantedBy=multi-user.target
